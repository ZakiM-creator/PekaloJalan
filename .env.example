# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Email admin (huruf kecil, pisahkan dengan koma bila lebih dari satu).
# Harus sama dengan daftar adminEmails di firestore.rules.
VITE_ADMIN_EMAILS=

# Google Maps & Places API Key
VITE_GOOGLE_MAPS_API_KEY=

# Kunci AI untuk chatbot (rantai model di api/chat.js). SERVER SAJA: tanpa awalan VITE_ supaya tidak masuk ke browser.
# Isi yang Anda punya, yang kosong otomatis dilewati. Di Vercel isi lewat Project Settings > Environment Variables.
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Opsional: ganti nama model tanpa mengubah kode, contoh MODEL_NVIDIA=deepseek-ai/deepseek-v4.1-flash

# Dipakai fitur deskripsi tempat di formulir admin (masih memanggil dari browser, belum dipindah ke server)
VITE_GEMINI_API_KEY=
VITE_OPENROUTER_API_KEY=

# Firebase (WAJIB: login Google dan database memakai Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
